# ---- Backend ----
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://allen:allen@db:5432/allen
REDIS_URL=redis://redis:6379/0
TOKEN_ENCRYPTION_KEY=            # Fernet key (Phase 5)

# ---- LLM (Phase 4) ----
ANTHROPIC_API_KEY=
# --- FREE option (recommended): Groq or Gemini, no credit card ---
# Groq:   key at console.groq.com  -> LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
# Gemini: key at aistudio.google.com/apikey -> LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# --- Paid option: set LLM_PROVIDER=anthropic, ANTHROPIC_API_KEY, LLM_MODEL=<claude model id>

# ---- STT cloud fallback (Phase 2) ----
OPENAI_API_KEY=                  # Whisper cloud STT
STT_MODEL=whisper-1
REGISTRATION_CODE=               # set a long random string; app sends it once to get a device token
GOOGLE_STT_CREDENTIALS=          # if using Google Cloud STT

# ---- Storage for Reels upload (Phase 5) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ---- Meta / Google (Phase 5) ----
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ---- Wake word (app build-time, Phase 2) ----
PICOVOICE_ACCESS_KEY=
